FROM node:20-alpine3.20 as builder

RUN apk add --no-cache bash



WORKDIR /das-api

# Only add basic files without the source code to avoid rebuilding
COPY package.json package.json
COPY .yarn .yarn
RUN yarn install --legacy-peer-deps --ignore-scripts


# Copy the Nx workspace
COPY ./nx.json nx.json
COPY ./jest.config.ts jest.config.ts
COPY ./tsconfig.base.json tsconfig.base.json

COPY ./apps/webapi/src apps/webapi/src
COPY ./apps/webapi/tsconfig.json apps/webapi
COPY ./apps/webapi/tsconfig.app.json apps/webapi
COPY ./apps/webapi/tsconfig.build.json apps/webapi
COPY ./apps/webapi/project.json apps/webapi
COPY ./apps/webapi/webpack.config.js apps/webapi
COPY ./apps/webapi/schema.gql apps/webapi


RUN yarn webapi:build:prod


# dist folder needs node_modules
WORKDIR /das-api/dist/apps/webapi

# package.json was generated by the build process
RUN npm install --legacy-peer-deps


# Overwrite the generated package.json with the original one to ensure having all scripts
COPY package.json /app/dist/apps/webapi



FROM node:20-slim
COPY --chown=node:node --from=builder /das-api/dist/apps /das-api/apps

# nest.js needs to modify schema.gql
# not a good soultion, need to move schema.gql to a temp folder
RUN chmod -R u+w /das-api/apps



WORKDIR /das-api/apps/webapi
EXPOSE ${PORT:-3000}

USER node
CMD ["node", "main.js"]
